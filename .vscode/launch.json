{
  // F5 로 디버깅: 미리보기로 떠 있는 앱을 멈추고 빌드한 뒤 5080 포트에서 디버거를 붙여 실행한다
  "version": "0.2.0",
  "configurations": [
    {
      "name": "과제 스케줄러 (디버그)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "디버그 준비",
      "program": "${workspaceFolder}/src/GanttScheduler/bin/Debug/net10.0/GanttScheduler.dll",
      "cwd": "${workspaceFolder}/src/GanttScheduler",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://0.0.0.0:5080"
      },
      "stopAtEntry": false
    }
  ]
}
