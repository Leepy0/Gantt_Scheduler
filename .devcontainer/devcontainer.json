{
  // GitHub Codespaces 미리보기 환경 — 열면 앱이 샘플 데이터(SQLite)로 자동 실행되고 5080 포트가 열린다
  "name": "Gantt Scheduler",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" }
  },
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_NOLOGO": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "customizations": {
    "vscode": { "extensions": ["ms-dotnettools.csharp"] }
  },
  "forwardPorts": [5080],
  "portsAttributes": {
    "5080": { "label": "과제 스케줄러", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "dotnet build src/GanttScheduler",
  "postStartCommand": "tools/preview.sh start"
}
