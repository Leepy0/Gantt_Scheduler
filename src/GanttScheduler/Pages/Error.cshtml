@page
@attribute [Microsoft.AspNetCore.Mvc.IgnoreAntiforgeryToken]
@{
    // 본문 없는 오류 응답은 Program.cs 의 UseStatusCodePagesWithReExecute 가 ?code=상태코드 로 이 화면을 다시 그린다.
    // 예외(500)는 code 없이 온다
    int.TryParse(Request.Query["code"], out var code);
    var (title, message) = code switch
    {
        404 => ("찾는 화면이 없습니다", "과제가 삭제되었거나 주소가 잘못되었습니다. 목록에서 다시 찾아 주세요."),
        403 => ("접근할 수 없습니다", "이 화면을 볼 수 있는 권한이 없습니다."),
        400 => ("요청을 처리하지 못했습니다", "화면이 오래되었을 수 있습니다. 새로 고친 뒤 다시 시도해 주세요."),
        _ => ("요청을 처리하지 못했습니다", "서버에서 오류가 발생했습니다. 잠시 후 다시 시도하고, 계속되면 관리자에게 알려 주세요."),
    };
    ViewData["Title"] = code == 404 ? "찾을 수 없음" : "오류";
    ViewData["Bare"] = true;
    // 서버 오류에는 오류 번호(요청 번호)를 보인다. 같은 번호가 서버 로그(App_Data/logs)에 남아 관리자가 원인을 찾을 수 있다
    var errorId = code == 0 || code >= 500 ? HttpContext.TraceIdentifier : null;
    var at = DateTime.UtcNow;
}
<section class="welcome">
    <div class="card welcome-card" data-error-code="@(code == 0 ? null : code)">
        <h1>@title</h1>
        <p class="muted">@message</p>
        @if (errorId != null)
        {
            <p class="error-id" id="error-id">오류 번호 <code>@errorId</code> · <time datetime="@at.ToString("yyyy-MM-ddTHH:mm:ssZ")">@KoreaClock.ToKst(at).ToString("yyyy-MM-dd HH:mm") (한국 시간)</time></p>
        }
        @if (code == 404)
        {
            <a class="btn primary block" href="~/Projects">과제 목록으로 이동</a>
            <a class="btn block" href="~/">대시보드로 이동</a>
        }
        else
        {
            <a class="btn primary block" href="~/">대시보드로 이동</a>
        }
    </div>
</section>
