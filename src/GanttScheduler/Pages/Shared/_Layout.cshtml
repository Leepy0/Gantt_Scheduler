@inject CurrentUser Me
@inject UpdateService Updates
@inject IClock Clock
@inject OpsAlerts Alerts
@{
    var nav = ViewData["Nav"] as string ?? "";
    var bare = ViewData["Bare"] as bool? ?? false;
    // 관리자에게만 서버 문제(업데이트 실패·디스크 부족·백업 오래됨·내년 공휴일 없음)와 새 버전을 알린다 — 가장 중요한 것 하나와 나머지 수
    var alerts = Me.IsAdmin && !bare ? await Alerts.ForAdminAsync(Context.RequestServices.GetRequiredService<GanttScheduler.Data.AppDb>()) : null;
}
<!DOCTYPE html>
@* data-today: 한국 날짜(지연 판정의 '오늘'). 화면이 오래 열려 있으면 /version 응답의 today 로 갱신한다
   data-day-window: 접속자 PC 의 날짜를 '오늘'로 받아 주는 범위(한국 날짜 ± 일수, Rules.ClientDayWindow) — App.userToday 가 쓴다 *@
<html lang="ko" data-build="@Updates.Build.Id" data-today="@Clock.Today.ToString("yyyy-MM-dd")" data-day-window="@Rules.ClientDayWindow">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1428A0" />
    <title>@ViewData["Title"] · 과제 스케줄러</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(bare ? "bare" : "")">
    <partial name="_Icons" />
    @if (!bare)
    {
        <header class="top">
            <a class="brand" asp-page="/Index">과제 스케줄러</a>
            <nav class="top-nav" aria-label="주 메뉴">
                <a asp-page="/Index" class="@(nav == "dash" ? "on" : "")" aria-current="@(nav == "dash" ? "page" : null)">대시보드</a>
                <a asp-page="/My/Index" class="@(nav == "my" ? "on" : "")" aria-current="@(nav == "my" ? "page" : null)">내 할 일</a>
                <a asp-page="/Projects/Index" class="@(nav == "projects" ? "on" : "")" aria-current="@(nav == "projects" ? "page" : null)">과제</a>
                <a asp-page="/Insights/LeadTime" class="@(nav == "insights" ? "on" : "")" aria-current="@(nav == "insights" ? "page" : null)">분석</a>
                <a asp-page="/Admin/Index" class="@(nav == "admin" ? "on" : "")" aria-current="@(nav == "admin" ? "page" : null)">관리</a>
            </nav>
            @if (alerts is { Count: > 0 })
            {
                var top = alerts[0];
                var more = alerts.Count > 1 ? $" 외 {alerts.Count - 1}건" : "";
                var all = string.Join(" · ", alerts.Select(a => a.Text));
                <a class="chip @(top.Level == "warn" ? "warn" : "accent") top-update" id="ops-alert" href="@Url.Content("~" + top.Href)" title="@all" aria-label="관리자 알림: @all">
                    <svg class="ic"><use href="#i-@(top.Level == "warn" ? "alert" : "download")" /></svg><span>@top.Text@more</span>
                </a>
            }
            @* 알림 종: 읽지 않은 수는 화면이 따로 묻는다(/api/unread — collab.js). 모든 화면 요청에 알림 조회를 붙이지 않기 위해서다 *@
            <a class="bell" id="bell" asp-page="/My/Notifications" aria-label="알림" title="알림">
                <svg class="ic"><use href="#i-bell" /></svg><span class="bell-count" id="bell-count" hidden></span>
            </a>
            @* 내 이름을 누르면 이 기기의 사용자를 바꾼다 (IP 가 다른 사람에게 넘어왔거나 공용 PC 인 경우) *@
            <a class="me" asp-page="/Welcome" asp-route-switch="1" asp-route-returnUrl="@(Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString)"
               title="@(Views.OrgName(Me.User?.OrgUnit) ?? "소속 미지정") · 접속 IP @Me.Ip · 눌러서 사용자 바꾸기" aria-label="@Me.Name — 사용자 바꾸기">
                <svg class="ic"><use href="#i-user" /></svg>
                <span>@Me.Name</span>
            </a>
        </header>
    }
    <main class="page">
        @RenderBody()
    </main>
    @if (!bare)
    {
        <nav class="bottom-nav" aria-label="주 메뉴">
            <a asp-page="/Index" class="@(nav == "dash" ? "on" : "")" aria-current="@(nav == "dash" ? "page" : null)"><svg class="ic"><use href="#i-dash" /></svg><span>대시보드</span></a>
            <a asp-page="/My/Index" class="@(nav == "my" ? "on" : "")" aria-current="@(nav == "my" ? "page" : null)"><svg class="ic"><use href="#i-tasks" /></svg><span>내 할 일</span></a>
            <a asp-page="/Projects/Index" class="@(nav == "projects" ? "on" : "")" aria-current="@(nav == "projects" ? "page" : null)"><svg class="ic"><use href="#i-list" /></svg><span>과제</span></a>
            <a asp-page="/Insights/LeadTime" class="@(nav == "insights" ? "on" : "")" aria-current="@(nav == "insights" ? "page" : null)"><svg class="ic"><use href="#i-chart" /></svg><span>분석</span></a>
            <a asp-page="/Admin/Index" class="@(nav == "admin" ? "on" : "")" aria-current="@(nav == "admin" ? "page" : null)"><svg class="ic"><use href="#i-gear" /></svg><span>관리</span></a>
        </nav>
    }
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>
    @Html.AntiForgeryToken()
    <script>window.APP_BASE = '@Url.Content("~/")';</script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/collab.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
