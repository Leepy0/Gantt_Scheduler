@page
@model LeadTimeModel
@{
    ViewData["Title"] = "리드타임";
    ViewData["Nav"] = "insights";
    ViewData["Tab"] = "lead";
    string Pct(double v, int max) => (v * 100.0 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    string Signed(double v) => (v > 0 ? "+" : "") + v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="page-head"><h1>분석</h1></div>
<partial name="_InsightTabs" />

<div class="toolbar">
    <p class="muted lead-note">단계 소요일은 앞 단계 완료일(첫 단계는 착수일)부터 그 단계 완료일까지입니다. 완료한 단계만 집계하고, 근무일은 주말·공휴일을 뺀 날 수입니다.
        목표 대비는 완료일 − 목표일(달력일)이며, 여러 번 미룬 단계는 '지금 목표 대비'보다 '처음 목표 대비'가 실제 지연에 가깝습니다.</p>
    <span class="spacer"></span>
    @* 0일 표본: 앞 단계와 같은 날(또는 먼저) 완료한 기록 — 몰아서 완료 처리해 실제 기간을 알 수 없다 *@
    <div class="seg small" role="group" aria-label="0일 표본">
        <a asp-page="/Insights/LeadTime" asp-route-year="@Model.Year" class="@(Model.ExcludeZero ? "" : "on")">0일 표본 포함</a>
        <a asp-page="/Insights/LeadTime" asp-route-zero="exclude" asp-route-year="@Model.Year" class="@(Model.ExcludeZero ? "on" : "")" data-zero-exclude>0일 표본 제외</a>
    </div>
    @* 종료 연도: 그 해에 끝난 완료 과제만 센다(해마다 공정·인원이 달라 평균을 해별로 견주기 위해). 전체는 진행 과제의 완료 단계까지 *@
    <form method="get" class="lead-year">
        @if (Model.ExcludeZero) { <input type="hidden" name="zero" value="exclude" /> }
        <select name="year" id="lead-year" aria-label="종료 연도" onchange="this.form.submit()">
            <option value="">전체 기간</option>
            @foreach (var y in Model.Years)
            {
                <option value="@y" selected="@(Model.Year == y)">@(y)년 종료 과제</option>
            }
        </select>
        <noscript><button type="submit" class="btn small">조회</button></noscript>
    </form>
</div>
@if (Model.Year != null)
{
    <p class="form-note lead-year-note" data-lead-year>@(Model.Year)년에 끝난 완료 과제만 셉니다. 진행 중인 과제가 없으므로 '진행 중 · 평균 초과' 열은 비어 있습니다.</p>
}

@if (Model.Groups.All(g => g.Rows.Count == 0))
{
    <section class="card"><p class="empty">@(Model.Year != null ? $"{Model.Year}년에 끝난 과제가 없어 통계를 낼 수 없습니다." : "완료한 단계가 아직 없어 통계를 낼 수 없습니다.")</p></section>
}

@foreach (var g in Model.Groups.Where(g => g.Rows.Count > 0))
{
    <section class="card">
        <header class="card-head">
            <h2>@g.Category</h2>
            <span class="chip">과제 @g.Projects</span>
            <span class="chip">완료 @g.DoneProjects</span>
            <span class="spacer"></span>
            @if (g.AvgTotalDays != null)
            {
                <span class="muted">착수~완료 평균 <b class="num">@g.AvgTotalDays</b>일 (근무일 <b class="num">@g.AvgTotalWorkDays</b>일)</span>
            }
        </header>
        <div class="table-scroll">
            <table class="simple-table lead-table">
                <thead>
                    <tr>
                        <th>단계</th><th class="r">표본</th><th class="r">평균(근무일)</th><th class="r">평균(일)</th><th>최소 ~ 최대(일)</th><th class="r">0일 표본</th>
                        <th class="r">지금 목표 대비</th><th class="r">처음 목표 대비</th><th class="r">기준선 대비</th><th class="r">목표 초과</th>
                        <th class="r" title="지금 이 단계에 있는 진행 과제 · 그중 머문 근무일이 평균 소요일을 넘은 과제">진행 중 · 평균 초과</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in g.Rows)
                    {
                        <tr data-lead-row="@r.Stage">
                            <td><b>@r.Stage</b></td>
                            <td class="r">@r.Count</td>
                            <td class="r"><b>@(r.Count == 0 ? "-" : r.AvgWorkDays.ToString("0.#"))</b></td>
                            <td class="r">@(r.Count == 0 ? "-" : r.AvgDays.ToString("0.#"))</td>
                            <td class="lead-range">
                                @if (r.Count > 0)
                                {
                                    <span class="range-track" title="최소 @(r.MinDays)일 · 평균 @(r.AvgDays)일 · 최대 @(r.MaxDays)일">
                                        <i class="range-bar" style="left:@Pct(r.MinDays, g.ScaleMax);width:@Pct(Math.Max(r.MaxDays - r.MinDays, 0), g.ScaleMax)"></i>
                                        <i class="range-avg" style="left:@Pct(r.AvgDays, g.ScaleMax)"></i>
                                    </span>
                                    <span class="num muted">@r.MinDays ~ @r.MaxDays</span>
                                }
                            </td>
                            <td class="r" title="앞 단계와 같은 날(또는 먼저) 완료한 표본">@r.ZeroCount@(Model.ExcludeZero && r.ZeroCount > 0 ? " 제외" : "")</td>
                            <td class="r @(r.AvgOver > 0 ? "t-alarm" : r.AvgOver < 0 ? "t-ok" : "")">@(r.AvgOver == null ? "-" : Signed(r.AvgOver.Value) + "일")</td>
                            <td class="r @(r.AvgOverFirst > 0 ? "t-alarm" : r.AvgOverFirst < 0 ? "t-ok" : "")" data-lead-first>@(r.AvgOverFirst == null ? "-" : Signed(r.AvgOverFirst.Value) + "일")</td>
                            <td class="r @(r.AvgOverBaseline > 0 ? "t-alarm" : r.AvgOverBaseline < 0 ? "t-ok" : "")">@(r.AvgOverBaseline == null ? "-" : Signed(r.AvgOverBaseline.Value) + "일 (" + r.BaselineCount + "건)")</td>
                            <td class="r @(r.LateCount > 0 ? "t-alarm" : "")">@r.LateCount / @r.OverCount</td>
                            <td class="r lead-active" data-lead-active>
                                @if (r.Active == 0) {<span class="muted">-</span>}
                                else
                                {
                                    <span>진행 중 @r.Active</span>
                                    @if (r.ActiveOver > 0)
                                    {
                                        <text> · </text><a href="#over-@g.CategoryId" class="warn" data-lead-over>평균 초과 @r.ActiveOver</a>
                                    }
                                    else if (r.Count > 0)
                                    {
                                        <span class="muted"> · 평균 초과 0</span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (g.Over is { Count: > 0 })
        {
            @* 단계 병목: 지금 단계에 평균 소요일보다 오래 머문 진행 과제 (리드타임과 같은 기준점·근무일) *@
            <details class="bottleneck" id="over-@g.CategoryId" data-bottleneck open>
                <summary>평균보다 오래 머문 진행 과제 @(g.Over.Count)건</summary>
                <table class="simple-table">
                    <thead><tr><th>과제</th><th>지금 단계</th><th class="r">머문 근무일</th><th class="r">평균 소요(근무일)</th></tr></thead>
                    <tbody>
                        @foreach (var o in g.Over)
                        {
                            <tr><td><a asp-page="/Projects/Detail" asp-route-id="@o.ProjectId">@o.Project</a></td><td>@o.Stage</td>
                                <td class="r"><b>@o.Dwell</b></td><td class="r">@o.Avg.ToString("0.#")</td></tr>
                        }
                    </tbody>
                </table>
            </details>
        }
    </section>
}
