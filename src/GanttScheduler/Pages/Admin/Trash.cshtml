@page
@model GanttScheduler.Pages.Admin.TrashModel
@{
    ViewData["Title"] = "휴지통";
    ViewData["Nav"] = "admin";
}

<div class="page-head">
    <a class="btn icon ghost" asp-page="/Admin/Index" aria-label="관리로 돌아가기"><svg class="ic"><use href="#i-left" /></svg></a>
    <h1>휴지통</h1>
    <span class="count">@Model.Rows.Count</span>
</div>

<p class="form-note" id="trash-note">
    <svg class="ic"><use href="#i-clock" /></svg>
    <span>
        @if (Model.AutoPurge)
        {
            <text>지운 과제는 @(Model.KeepDays)일 동안 보관한 뒤 첨부·활동 이력과 함께 자동으로 영구 삭제됩니다(설정 Trash:KeepDays). 그 전에는 되살릴 수 있습니다.</text>
        }
        else
        {
            <text>자동 영구 삭제가 꺼져 있습니다(Trash:KeepDays = 0). 지운 과제는 여기서 직접 영구 삭제할 때까지 남습니다.</text>
        }
    </span>
</p>

<section class="card" id="trash">
    <header class="card-head"><h2>지운 과제</h2></header>
    @if (Model.Rows.Count == 0)
    {
        <p class="empty">휴지통이 비어 있습니다.</p>
    }
    else
    {
        <ul class="rows" id="trash-list">
            @foreach (var r in Model.Rows)
            {
                var t = r.Item;
                <li class="trash-row" data-trash="@t.Id">
                    <span class="row-main">
                        <span class="row-title">@t.Title</span>
                        <span class="row-sub">
                            담당 @t.Owner · 단계 @t.Stages · 첨부 @t.Attachments
                            · <time datetime="@t.DeletedAt.ToString("O")">@t.DeletedAt.ToString("yyyy-MM-dd HH:mm")</time> @(t.DeletedBy ?? "-") 삭제
                            @if (r.PurgeAt is DateTime at)
                            {
                                <text> · 영구 삭제 예정 </text><time datetime="@at.ToString("O")">@at.ToString("yyyy-MM-dd")</time>
                            }
                        </span>
                        @if (!string.IsNullOrEmpty(t.Reason))
                        {
                            <span class="row-sub">사유: @t.Reason</span>
                        }
                    </span>
                    <span class="trash-actions">
                        <button type="button" class="btn small" data-restore="@t.Id" data-title="@t.Title"><svg class="ic"><use href="#i-refresh" /></svg>복원</button>
                        <button type="button" class="btn small danger" data-purge="@t.Id" data-title="@t.Title"><svg class="ic"><use href="#i-trash" /></svg>영구 삭제</button>
                    </span>
                </li>
            }
        </ul>
    }
</section>

<section class="card" id="purge-log">
    <header class="card-head"><h2>영구 삭제 기록</h2><span class="count">@Model.Log.Count</span></header>
    @if (Model.Log.Count == 0)
    {
        <p class="empty">영구 삭제한 과제가 없습니다.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="simple-table trash-log">
                <thead><tr><th>과제</th><th>삭제</th><th>사유</th><th>영구 삭제</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Log)
                    {
                        <tr>
                            <td>@l.Title <span class="muted num">#@l.ProjectId</span></td>
                            <td>@(l.DeletedBy ?? "-")@if (l.DeletedAt is DateTime d) {<text> · </text><time datetime="@d.ToString("O")">@d.ToString("yyyy-MM-dd HH:mm")</time>}</td>
                            <td>@(l.Reason ?? "-")</td>
                            <td>@l.PurgedBy · <time datetime="@l.PurgedAt.ToString("O")">@l.PurgedAt.ToString("yyyy-MM-dd HH:mm")</time></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/trash.js" asp-append-version="true"></script>
}
