@page
@model GanttScheduler.Pages.Admin.StatusModel
@{
    ViewData["Title"] = "서버 상태";
    ViewData["Nav"] = "admin";
}

<div class="page-head">
    <a class="btn icon ghost" asp-page="/Admin/Index" aria-label="관리로 돌아가기"><svg class="ic"><use href="#i-left" /></svg></a>
    <h1>서버 상태</h1>
    <span class="spacer"></span>
    <a class="btn small" asp-page="/Admin/Update"><svg class="ic"><use href="#i-download" /></svg>업데이트·백업</a>
    <button type="button" class="btn small" id="status-refresh"><svg class="ic"><use href="#i-refresh" /></svg>다시 점검</button>
</div>

<section id="status-body" class="status-body">
    <div class="loading"><span class="spinner"></span>불러오는 중…</div>
</section>

<script type="application/json" id="page-data">@Html.Raw(Model.DataJson)</script>

@section Scripts {
    <script src="~/js/status.js" asp-append-version="true"></script>
}
