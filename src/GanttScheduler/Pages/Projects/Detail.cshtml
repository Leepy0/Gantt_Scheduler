@page
@model GanttScheduler.Pages.Projects.DetailModel
@{
    ViewData["Title"] = Model.Project.Title;
    ViewData["Nav"] = "projects";
}

<div id="detail" class="detail">
    <div class="page-head">
        @* 목록에서 들어왔으면 detail.js 가 브라우저 뒤로 가기로 바꿔 목록의 필터를 지킨다 *@
        <a class="btn icon" id="back-link" asp-page="/Projects/Index" aria-label="과제 목록"><svg class="ic"><use href="#i-left" /></svg></a>
        <h1 id="p-title">@Model.Project.Title</h1>
    </div>

    @* 다른 사용자가 이 과제를 바꿨거나 삭제했을 때의 안내 (자동으로 새로 고치지 않는다) *@
    <div class="change-banner" id="change-banner" role="status" hidden></div>

    @* 저장할 때마다 통째로 다시 그리는 곳이라 aria-live 를 두지 않는다 — 결과 알림은 #toasts 가 읽어 준다 *@
    <section class="card summary" id="summary"></section>

    <nav class="stepper" id="stepper" aria-label="단계 진행"></nav>

    <div class="tabs scroll" role="tablist">
        <button type="button" role="tab" class="on" data-tab="schedule" aria-selected="true" aria-controls="tab-schedule">일정</button>
        <button type="button" role="tab" data-tab="info" aria-selected="false" aria-controls="tab-info">정보</button>
        <button type="button" role="tab" data-tab="files" aria-selected="false" aria-controls="tab-files">자료 <span class="count" id="files-count"></span></button>
        <button type="button" role="tab" data-tab="activity" aria-selected="false" aria-controls="tab-activity">활동 <span class="count" id="activity-count"></span></button>
    </div>

    <section class="tab-panel" id="tab-schedule">
        <div class="toolbar">
            <div class="seg small" id="view-mode" role="group" aria-label="보기 방식">
                <button type="button" data-view="gantt"><svg class="ic"><use href="#i-gantt" /></svg>간트</button>
                <button type="button" data-view="list"><svg class="ic"><use href="#i-list" /></svg>목록</button>
            </div>
            <div class="seg small" id="zoom" role="group" aria-label="간트 배율">
                <button type="button" data-zoom="day">일</button>
                <button type="button" data-zoom="week">주</button>
                <button type="button" data-zoom="month">월</button>
            </div>
            <button type="button" class="btn small" id="go-today">오늘</button>
            <button type="button" class="btn small toggle" id="show-baseline" aria-pressed="false"><svg class="ic"><use href="#i-pin" /></svg>기준선</button>
            <button type="button" class="btn small toggle" id="show-links" aria-pressed="false"><svg class="ic"><use href="#i-link" /></svg>의존선</button>
            <span class="spacer"></span>
            <button type="button" class="btn small" id="edit-schedule"><svg class="ic"><use href="#i-calendar" /></svg>단계 일정 편집</button>
            <button type="button" class="btn small" id="add-stage"><svg class="ic"><use href="#i-plus" /></svg>단계</button>
            <button type="button" class="btn small primary" id="add-work"><svg class="ic"><use href="#i-plus" /></svg>작업</button>
        </div>
        <div class="card flush" id="schedule-gantt">
            <div id="gantt" class="gantt-host tall"></div>
            <div class="legend">
                <span><i class="lg plan"></i>목표</span>
                <span><i class="lg done"></i>실적(완료)</span>
                <span><i class="lg cur"></i>실적(진행 중)</span>
                <span><i class="lg over"></i>목표 초과 완료</span>
                <span><i class="lg late"></i>지연</span>
                <span><i class="lg fc"></i>작업 기준 예상 종료</span>
                <span><i class="lg base"></i>기준선</span>
                <span><i class="lg crit"></i>임계(여유 없음)</span>
                <span class="hide-sm">막대를 끌어 일정 변경</span>
            </div>
        </div>
        <div id="schedule-list" class="stage-list" hidden></div>
    </section>

    <section class="tab-panel" id="tab-info" hidden></section>

    <section class="tab-panel" id="tab-files" hidden>
        <form class="card form" id="upload-form">
            <div class="field-row">
                <label class="field" data-field="file">
                    <span class="label">파일</span>
                    <input type="file" id="file-input" />
                </label>
                <label class="field">
                    <span class="label">관련 단계 <span class="opt">선택</span></span>
                    <select id="file-stage"></select>
                </label>
            </div>
            <span class="hint">이미지·PDF·Office·한글·zip 파일, 30MB 이하</span>
            <div class="form-actions"><button type="submit" class="btn primary" id="upload-btn"><svg class="ic"><use href="#i-upload" /></svg>올리기</button></div>
        </form>
        <div class="card flush"><ul class="files" id="files"></ul></div>
    </section>

    <section class="tab-panel" id="tab-activity" hidden>
        <form class="card comment-form" id="comment-form">
            <label class="field">
                <span class="label">진행 내용 남기기</span>
                <textarea id="comment-text" rows="2" maxlength="1000" placeholder="진행 상황이나 이슈를 남겨 주세요"></textarea>
            </label>
            <div class="form-actions"><button type="submit" class="btn primary" id="comment-btn">등록</button></div>
        </form>
        <div class="card flush">
            <ul class="feed" id="feed"></ul>
            @* 활동은 최근 것부터 나눠 받는다(ProjectService.ActivityPageSize). 기간·사람·종류로 찾을 때는 변경 이력 화면으로 *@
            <div class="feed-foot">
                <span class="muted num" id="feed-status" aria-live="polite"></span>
                <span class="spacer"></span>
                <button type="button" class="btn small no-print" id="feed-more" hidden><svg class="ic"><use href="#i-down" /></svg>더 보기</button>
                <a class="btn small ghost no-print" id="feed-history" asp-page="/Insights/History" asp-route-projectId="@Model.Project.Id"><svg class="ic"><use href="#i-list" /></svg>이 과제 전체 이력</a>
            </div>
        </div>
    </section>
</div>

<script id="page-data" type="application/json">@Html.Raw(Model.DataJson)</script>
@section Scripts {
    <script src="~/js/gantt.js" asp-append-version="true"></script>
    <script src="~/js/schedule.js" asp-append-version="true"></script>
    <script src="~/js/detail.js" asp-append-version="true"></script>
}
