@page
@model GanttScheduler.Pages.Projects.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "과제 등록" : "과제 수정";
    ViewData["Nav"] = "projects";
}

<div class="page-head">
    <a class="btn icon" href="@(Model.IsNew ? Url.Page("/Projects/Index") : Url.Page("/Projects/Detail", new { id = Model.Id }))" aria-label="뒤로"><svg class="ic"><use href="#i-left" /></svg></a>
    <h1>@(Model.IsNew ? "과제 등록" : "과제 수정")</h1>
</div>

@if (Model.NeedsSetup)
{
    <div class="edit-setup"><partial name="_SetupNeeded" model="Model.IsAdmin" /></div>
}

<form method="post" class="card form edit-form" id="edit-form" novalidate>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Form.LocationId" id="location-id" />
    <input type="hidden" asp-for="Form.Version" />
    <input type="hidden" asp-for="Form.Base" />

    @if (Model.Error != null)
    {
        <p class="form-error" role="alert"><svg class="ic"><use href="#i-alert" /></svg>@Model.Error</p>
    }

    <label class="field" data-field="title">
        <span class="label">과제명</span>
        <input asp-for="Form.Title" maxlength="@Limits.ProjectTitle" required autocomplete="off" />
        <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("title") ?? "")" />
    </label>

    <div class="field" data-field="categoryId">
        <span class="label">유형</span>
        @if (Model.IsNew)
        {
            <div class="choice-row" role="radiogroup" aria-label="유형">
                @foreach (var c in Model.Categories)
                {
                    <label class="choice">
                        <input type="radio" name="Form.CategoryId" value="@c.Id" checked="@(Model.Form.CategoryId == c.Id)" />
                        <span>@c.Name</span>
                    </label>
                }
            </div>
            <span class="hint">유형별 기본 단계 생성. 등록 후 변경 불가.</span>
        }
        else
        {
            <input type="hidden" asp-for="Form.CategoryId" />
            <div class="readonly">@Model.CategoryName</div>
        }
    </div>

    <div class="field" data-field="locationId">
        <span class="label">위치</span>
        <div class="cascade" id="cascade">
            <select data-level="1" aria-label="법인"></select>
            <select data-level="2" aria-label="제품군"></select>
            <select data-level="3" aria-label="라인"></select>
            <select data-level="4" aria-label="층"></select>
        </div>
        <span class="hint">법인은 필수, 나머지는 아는 데까지 선택합니다.</span>
        <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("locationId") ?? "")" />
    </div>

    <div class="field-row">
        <label class="field" data-field="owner">
            <span class="label">담당자</span>
            <input asp-for="Form.Owner" maxlength="@Limits.UserName" list="user-names" autocomplete="off" />
            <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("owner") ?? "")" />
        </label>
        <label class="field" data-field="startDate">
            <span class="label">착수일</span>
            <input type="date" name="Form.StartDate" id="Form_StartDate" value="@(Model.Form.StartDate?.ToString("yyyy-MM-dd"))" />
            <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("startDate") ?? "")" />
        </label>
    </div>

    <label class="field" data-field="vendor">
        <span class="label">협력사 <span class="opt">선택</span></span>
        <input asp-for="Form.Vendor" maxlength="@Limits.VendorName" list="vendor-names" autocomplete="off" />
        <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("vendor") ?? "")" />
    </label>

    <div class="field" id="items-field" data-field="equipments" hidden>
        <span class="label" id="items-label">기기 내역</span>
        <div id="items" class="items"></div>
        <button type="button" class="btn small" id="add-item"><svg class="ic"><use href="#i-plus" /></svg>행 추가</button>
        <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("items") ?? "")" />
    </div>

    <label class="field" data-field="description">
        <span class="label">설명 <span class="opt">선택</span></span>
        <textarea asp-for="Form.Description" rows="4" maxlength="@Limits.Description"></textarea>
        <partial name="_ConflictNote" model="@(Model.Changed.GetValueOrDefault("description") ?? "")" />
    </label>

    @if (Model.IsNew)
    {
        @* 단계 목표일 초안: 유형·착수일(·법인)을 고르면 stage-draft.js 가 서버에서 초안을 받아 그린다. 수정 화면에는 없다(상세의 단계 일정 편집) *@
        <div class="field" id="draft-field" data-field="stageTargets">
            <span class="label">단계 목표일 <span class="opt">선택</span></span>
            <div id="draft"></div>
            <div id="draft-fields" hidden></div>
            <span class="hint">기본 기간(근무일) 초안. 고친 날짜 뒤 단계는 다시 계산. 비우면 미정.</span>
        </div>
        @* 유형 템플릿 작업: 고른 유형에 작업 템플릿이 있을 때만 edit.js 가 보인다(개수 표시) *@
        <div class="field" id="template-works-field" data-field="templateWorks" hidden>
            <label class="check"><input type="checkbox" asp-for="Form.TemplateWorks" id="template-works" /><span id="template-works-label">템플릿 작업 함께 만들기</span></label>
            <span class="hint">유형의 기본 작업을 단계 시작일부터 근무일로 만듭니다. 담당은 과제 담당.</span>
        </div>
        @* 단계·작업 CSV 붙여넣기: 글이 있으면 기본 단계·템플릿 작업 대신 붙여 넣은 단계·작업으로 등록한다. 해석·검증은 서버(project-paste.js 가 미리보기를 받는다) *@
        <div class="field" id="paste-field" data-field="pasteText">
            <span class="label">단계·작업 붙여넣기 <span class="opt">선택</span> <partial name="_HelpQ" model="@("paste")" /></span>
            <textarea asp-for="Form.PasteText" id="paste-text" rows="6" spellcheck="false"
                      placeholder="단계,작업명,담당,목표 시작,목표 종료,선행 단계,선행 작업,동시&#10;설계,,,,2026-10-30,,,&#10;설계,현장 실사,김물류,2026-10-12,2026-10-14,,,&#10;설계,사양 검토,김물류,2026-10-15,2026-10-21,,현장 실사,&#10;제작,,,,,,,&#10;제작,시제품 제작,,2026-10-22,2026-11-05,설계,사양 검토,&#10;교육,,,,2026-11-05,,,동시"></textarea>
            <div class="inline-btns">
                <button type="button" class="btn small" id="paste-check"><svg class="ic"><use href="#i-search" /></svg>확인</button>
                <button type="button" class="btn small" id="paste-sample"><svg class="ic"><use href="#i-copy" /></svg>샘플 CSV 복사</button>
                <a class="btn small" id="paste-download" href="#" download><svg class="ic"><use href="#i-download" /></svg>샘플 CSV 파일</a>
                <button type="button" class="btn small ghost" id="paste-clear" hidden><svg class="ic"><use href="#i-x" /></svg>비우기</button>
            </div>
            <div id="paste-preview" class="paste-preview"></div>
            <span class="hint">Excel·CSV 내용을 붙여 넣습니다 (쉼표나 TAB, 한 줄에 하나): 단계 · 작업명 · 담당 · 목표 시작 · 목표 종료 · 선행 단계 · 선행 작업 · 동시.
                작업명이 비면 단계 줄(목표 종료 = 단계 목표일, 동시에 글자 = 앞 단계와 동시), 있으면 그 단계의 작업입니다. 선행 단계를 비우면 같은 단계의 작업입니다.
                목표일을 비운 단계는 작업 일정에 맞춥니다. 담당을 비우면 과제 담당입니다.</span>
        </div>
    }

    <div class="form-actions">
        <a class="btn" href="@(Model.IsNew ? Url.Page("/Projects/Index") : Url.Page("/Projects/Detail", new { id = Model.Id }))">취소</a>
        <button type="submit" class="btn primary">@(Model.IsNew ? "등록" : "저장")</button>
    </div>

    <datalist id="user-names">
        @foreach (var n in Model.UserNames) {<option value="@n"></option>}
    </datalist>
    <datalist id="vendor-names">
        @foreach (var n in Model.VendorNames) {<option value="@n"></option>}
    </datalist>
</form>

<script id="page-data" type="application/json">@Html.Raw(Model.MetaJson)</script>
@section Scripts {
    <script src="~/js/edit.js" asp-append-version="true"></script>
    @if (Model.IsNew)
    {
        <script src="~/js/stage-draft.js" asp-append-version="true"></script>
        <script src="~/js/project-paste.js" asp-append-version="true"></script>
    }
}
