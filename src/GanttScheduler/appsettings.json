{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "SqlitePath": "App_Data/gantt.db"
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=GanttScheduler;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Seed": {
    "Demo": false
  },
  "Storage": {
    "MaxMB": 30
  },
  "TrustForwardedHeaders": false,
  "Access": {
    "FirstAdminLocalOnly": true,
    "ReconfirmDays": 30,
    "AllowedNetworks": []
  },
  "Update": {
    "Source": "github:Leepy0/Gantt_Scheduler_Release"
  },
  "Backup": {
    "Path": "",
    "Keep": 7,
    "BeforeSchemaUpdate": true,
    "Nightly": false,
    "NightlyAt": "01:00"
  },
  "Logs": {
    "KeepDays": 30,
    "SlowRequestMs": 1000
  }
}
