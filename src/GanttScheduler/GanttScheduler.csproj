<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GanttScheduler</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 정식 배포할 때 올린다. 서버의 자동 업데이트가 이 값으로 새 버전인지 판단한다 -->
    <Version>0.5.0</Version>
    <!-- release = 정식 배포, dev = main 테스트 빌드, local = 로컬 빌드(자동 적용 안 함). CI 가 지정한다 -->
    <BuildChannel Condition="'$(BuildChannel)' == ''">local</BuildChannel>
    <!-- 배포(win-x64)와 업데이트 자체 시험(linux-x64)이 게시하는 대상. packages.lock.json 에 이 대상의 패키지까지 기록해 두어야
         CI 가 잠금 모드로 런타임 포함 게시를 할 수 있다. 일반 빌드 결과(bin/…/net10.0)는 그대로다 -->
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <UpdateKeyFile Condition="'$(UpdateKeyFile)' == ''">update-key.pub</UpdateKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildChannel" Value="$(BuildChannel)" />
    <!-- 이 빌드에 들어 있는 마지막 DB 마이그레이션. 업데이트가 DB 구조를 바꾸는지 판단하는 데 쓴다 (CI 가 지정) -->
    <AssemblyMetadata Include="SchemaId" Value="$(SchemaId)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GanttScheduler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 배포 파일 서명 확인용 공개키 (tools/release/keygen.sh 로 만든다). 있을 때만 빌드에 넣고, 넣은 빌드는 서명된 업데이트만 받는다.
         UpdateKeyFile 은 업데이트 자체 시험이 시험용 키를 넣을 때 바꾼다 -->
    <None Remove="update-key.pub" />
    <EmbeddedResource Include="$(UpdateKeyFile)" LogicalName="update-key.pub" Condition="'$(UpdateKeyFile)' != '' and Exists('$(UpdateKeyFile)')" />
  </ItemGroup>

  <ItemGroup>
    <!-- 서비스 등록·제거를 더블클릭으로 할 수 있게 배포 패키지에 넣는다 -->
    <None Update="install-service.cmd;uninstall-service.cmd" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
