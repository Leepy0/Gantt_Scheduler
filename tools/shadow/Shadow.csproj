<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- 로컬(오프라인) 검증 전용 프로젝트: 패키지 참조 없이 가짜 EF 로 빌드한다. tools/shadow/build.sh 가 사용 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GanttScheduler</RootNamespace>
    <AssemblyName>GanttScheduler</AssemblyName>
    <BuildChannel Condition="'$(BuildChannel)' == ''">local</BuildChannel>
    <UpdateKeyFile Condition="'$(UpdateKeyFile)' == ''">update-key.pub</UpdateKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildChannel" Value="$(BuildChannel)" />
    <AssemblyMetadata Include="SchemaId" Value="$(SchemaId)" />
    <!-- 실제 빌드와 같게: 배포 파일 서명 확인용 공개키가 있으면 넣는다 -->
    <None Remove="update-key.pub" />
    <EmbeddedResource Include="$(UpdateKeyFile)" LogicalName="update-key.pub" Condition="'$(UpdateKeyFile)' != '' and Exists('$(UpdateKeyFile)')" />
  </ItemGroup>
</Project>
